{
  "$schema_version": 1,
  "$comment": "Pulse config. Toggle each website on/off and provide its per-site config. Source-only sites (HN, Lobsters, arxiv, RSS) are scanned in Phase 3. Target-only sites (X, blog, etc.) define output lanes in Phase 4. Reddit is dual-role.",
  "sites": {
    "hackernews": {
      "enabled": true
    },
    "reddit": {
      "enabled": true,
      "subs": ["LocalLLaMA", "macapps"]
    },
    "lobsters": {
      "enabled": false
    },
    "arxiv": {
      "enabled": false
    },
    "rss": {
      "enabled": false,
      "feeds": []
    }
  },
  "targets": {
    "x-post": { "enabled": true },
    "reddit-comment": { "enabled": false },
    "medium": { "enabled": false },
    "blog": { "enabled": true, "min_words": 800, "max_words": 2000 },
    "linkedin": { "enabled": false },
    "substack": { "enabled": false }
  }
}
