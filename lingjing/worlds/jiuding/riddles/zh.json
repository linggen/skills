{
  "version": 1,
  "riddles": {
    "fuzhu-1": {
      "q": "一口咬掉牛尾巴。打一字。",
      "a": [
        "告"
      ],
      "choices": [
        "吉",
        "告",
        "牢",
        "舌"
      ],
      "hint": "口在上，牛在下——少了一截尾巴。"
    },
    "wu-1": {
      "q": "有头无颈，有眼无眉，无脚能走，有翅难飞。打一物。",
      "a": [
        "鱼"
      ],
      "choices": [
        "鸟",
        "船",
        "鱼",
        "蛇"
      ],
      "hint": "它就在河伯的水里。"
    },
    "seal-ji": {
      "q": "戴九履一，左三右七，二四为肩，六八为足。居中者何？",
      "a": [
        "五",
        "5"
      ],
      "choices": [
        "一",
        "九",
        "十五",
        "五"
      ],
      "hint": "洛书九宫，纵横皆十五。"
    },
    "lei-1": {
      "q": "雨落田上。打一字。",
      "a": [
        "雷"
      ],
      "choices": [
        "雪",
        "雷",
        "零",
        "需"
      ],
      "hint": "雨在上，田在下。"
    },
    "seal-yan": {
      "q": "河图：一六居北，二七居南，四九居西，五十居中。三八居于何方？",
      "a": [
        "东",
        "东方"
      ],
      "choices": [
        "西",
        "南",
        "东",
        "北"
      ],
      "hint": "木生于东，春从那边来。"
    },
    "kui-1": {
      "q": "一日一月。打一字。",
      "a": [
        "明"
      ],
      "choices": [
        "昌",
        "朋",
        "明",
        "旦"
      ],
      "hint": "日和月并肩。"
    },
    "seal-qing": {
      "q": "八卦：乾居南，坤居北，坎居西。东方当是何卦？",
      "a": [
        "离",
        "离卦"
      ],
      "choices": [
        "震",
        "离",
        "兑",
        "巽"
      ],
      "hint": "日出东方，火从那边来。"
    }
  }
