{
  "version": 1,
  "riddles": {
    "fuzhu-1": {
      "q": "一口咬掉牛尾巴。打一字。",
      "a": [
        "告"
      ],
      "hint": "口在上，牛在下——少了一截尾巴。"
    },
    "wu-1": {
      "q": "有头无颈，有眼无眉，无脚能走，有翅难飞。打一物。",
      "a": [
        "鱼"
      ],
      "hint": "它就在河伯的水里。"
    },
    "seal-ji": {
      "q": "戴九履一，左三右七，二四为肩，六八为足。居中者何？",
      "a": [
        "五",
        "5"
      ],
      "hint": "洛书九宫，纵横皆十五。"
    },
    "lei-1": {
      "q": "雨落田上。打一字。",
      "a": [
        "雷"
      ],
      "hint": "雨在上，田在下。"
    },
    "seal-yan": {
      "q": "河图：一六居北，二七居南，四九居西，五十居中。三八居于何方？",
      "a": [
        "东",
        "东方"
      ],
      "hint": "木生于东，春从那边来。"
    }
  }
}
