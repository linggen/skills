    "鼓",
    "战鼓",
    "夔鼓"
   ],
   "choices": [
    "甲",
    "旗",
    "鼓",
    "衣"
   ],
   "hint": "其声如雷——什么一敲，也声如雷？"
  },
  "seal-qing": {
   "q": "八卦：乾居南，坤居北，坎居西。东方当是何卦？",
   "a": [
    "离",
    "离卦"
   ],
   "choices": [
    "震",
    "离",
    "兑",
    "巽"
   ],
   "hint": "日出东方，火从那边来。"
  },
  "yinyue-moon": {
   "q": "千江有水千江月——天上的月，有几轮？",
