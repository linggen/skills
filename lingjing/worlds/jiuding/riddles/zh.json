    "一轮月"
   ],
   "choices": [
    "一轮",
    "千轮",
    "无数轮",
    "一轮也无"
   ],
   "hint": "江里的都是影子。"
  },
  "yinyue-bell": {
   "q": "不系时哑，系上便言；一动有声，停下无形。打一物。",
   "a": [
    "铃",
    "铃铛",
    "银月铃"
   ],
   "choices": [
    "铃",
    "笛",
    "佩",
    "镜"
   ],
   "hint": "你袖中正有一只。"
  },
  "yinyue-fox": {
   "q": "《山海经》：青丘之山有兽焉，其状如狐而九尾。是什么？",
   "a": [
    "九尾狐",
    "狐",
    "九尾"
   ],
   "choices": [
    "九尾狐",
    "狌狌",
    "讙",
    "天狗"
   ],
   "hint": "它的尾巴比身子多。"
  },
  "yinyue-char": {
   "q": "日月同行。打一字。",
   "a": [
    "明"
   ],
   "choices": [
    "明",
    "昍",
    "冥",
    "朋"
   ],
   "hint": "一边是日，一边是月。"
  }
 }
}
