{
  "about": "Card and bank statement lines (as a PDF reader rebuilds them) and which way each row's money moved. Shared with linggen-mobile: pdf-import.js parseStatementText and pdf_import.dart must both give each `expect` row (first row whose merchant contains `has`, case-insensitive) its signed amount, and `count` rows in all. `words` holds wording checks: in = a payment landing (any statement), card_bill = a card's own bill paid (card only), undone = a payment bounced. Synthetic: no real merchant or amount.",
  "cases": [
    {
      "name": "CA card, two dates per row, credits marked with a minus",
      "lines": [
        "Mastercard Statement date Sep. 4, 2026",
        "Credit limit $5,000.00",
        "Previous total balance, Aug. 4, 2026 $1,234.56",
        "Aug. 4 Aug. 5 NEW HARBOUR MARKET HALIFAX NS 93.87",
        "Aug. 21 Aug. 24 HARBOURSIDE PARKING 2.50",
        "Aug. 25 Aug. 25 AUTOMATIC PYMT RECEIVED -1,234.56",
        "Aug. 26 Aug. 27 CITY REC ONLINE -54.10",
        "Aug. 28 Aug. 31 SUGAR & SPICE BAKERY 15.91"
      ],
      "count": 5,
      "expect": [
        { "has": "NEW HARBOUR MARKET", "amount": -93.87 },
        { "has": "AUTOMATIC PYMT RECEIVED", "amount": 1234.56 },
        { "has": "CITY REC ONLINE", "amount": 54.1 },
        { "has": "SUGAR & SPICE", "amount": -15.91 }
      ]
    },
    {
      "name": "CA card, the payment printed with no sign at all",
      "lines": [
        "Mastercard Statement date Sep. 4, 2026",
        "Minimum payment $10.00",
        "Aug. 4 Aug. 5 NEW HARBOUR MARKET 93.87",
        "Aug. 25 Aug. 25 AUTOMATIC PYMT RECEIVED 1,234.56",
        "Aug. 26 Aug. 26 PAYMENT RECEIVED - THANK YOU 200.00"
      ],
      "count": 3,
      "expect": [
        { "has": "NEW HARBOUR MARKET", "amount": -93.87 },
        { "has": "AUTOMATIC PYMT RECEIVED", "amount": 1234.56 },
        { "has": "THANK YOU", "amount": 200.0 }
      ]
    },
